# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  bambooIT — Production Environment Variables                                ║
# ║  Copy to .env.prod and fill in all values before deploying                  ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ── Domain ────────────────────────────────────────────────────────────────────
# Your production domain (without https://)
DOMAIN=example.com

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=bambooit
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=bambooit_db
# NOTE: DATABASE_URL is set automatically in docker-compose.prod.yml
# If running outside Docker, set it manually:
# DATABASE_URL=postgresql://bambooit:PASSWORD@localhost:5432/bambooit_db?schema=public

# ── Encryption (AES-256-GCM) ─────────────────────────────────────────────────
# Generate: openssl rand -hex 32
# CRITICAL: Save this key! Losing it = losing all encrypted medical data
ENCRYPTION_KEY=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32 (min 32 chars)
JWT_SECRET=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Must match your frontend URL exactly (with https://)
CORS_ORIGIN=https://e-dietetyk.com

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production

# ── SMTP (email) — Resend ────────────────────────────────────────────────────
# Production uses Resend (https://resend.com) via SMTP.
# Requirements:
#   1. Resend account with verified sender domain (e-dietetyk.com)
#   2. API key from Resend Dashboard → API Keys (starts with "re_")
#   3. Sender email must match verified domain
# DPA: https://resend.com/legal (SCC for EU→US transfer)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_REPLACE_WITH_RESEND_API_KEY
SMTP_FROM="e-dietetyk.com <noreply@e-dietetyk.com>"

# ── Frontend URL (used in email links) ────────────────────────────────────────
APP_URL=https://e-dietetyk.com

# ── Redis ─────────────────────────────────────────────────────────────────────
# NOTE: REDIS_URL is set automatically in docker-compose.prod.yml
# If running outside Docker:
# REDIS_URL=redis://localhost:6379

# ── Next.js (frontend) ───────────────────────────────────────────────────────
# Public API URL — must be accessible from user's browser
NEXT_PUBLIC_API_URL=https://e-dietetyk.com/api
# Internal API URL — container-to-container (faster, no SSL overhead)
API_URL=http://backend:4000
# NextAuth — generate: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=https://e-dietetyk.com

# ── Stripe (payments) ────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
# Webhook signing secret — get from: Stripe Dashboard → Webhooks → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs — create in Stripe Dashboard → Products
STRIPE_PRICE_OPIEKA_MIESIECZNA=price_...
STRIPE_PRICE_OPIEKA_ROCZNA=price_...
STRIPE_PRICE_PLAN_2W=price_...
STRIPE_PRICE_PLAN_4W=price_...
STRIPE_PRICE_CONSULTATION=price_...

# ── OpenAI (AI diet generation) ──────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL_SIMPLE=gpt-4.1-mini
OPENAI_MODEL_COMPLEX=gpt-4o

# ── Encrypted daily backup (RODO Phase 2.3) ─────────────────────────────────
# Passphrase used to encrypt pg_dump snapshots with AES-256 (GPG symmetric).
# Generate once, save in a secure password manager:
#   openssl rand -base64 32
# LOSING THIS PASSPHRASE = BACKUPS ARE UNRECOVERABLE.
BACKUP_PASSPHRASE=
# Optional overrides — defaults: 02:00 Europe/Warsaw every day, keep 30 days
# BACKUP_CRON_SCHEDULE=0 2 * * *
# BACKUP_RETENTION_DAYS=30

# ── Feature flags ────────────────────────────────────────────────────────────
# Prompt version: v1 (AI calculates macros) or v2 (backend calculates from DB)
PROMPT_VERSION=v2
# Paywall: require active order before interview/plan access
PAYWALL_ENABLED=true
