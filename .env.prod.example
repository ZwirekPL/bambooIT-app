# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  bambooIT — Production env (Docker Compose)                                  ║
# ║  Skopiuj do .env.prod na VPS i uzupełnij wartości. NIE commituj .env.prod.   ║
# ║  VPS współdzielony z e-dietetyk (ADR-003) — bambooIT ma własne kontenery     ║
# ║  postgres/redis/backend/web (pełna izolacja, osobne wolumeny).               ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ── Domena ────────────────────────────────────────────────────────────────────
DOMAIN=bambooit.pl

# ── PostgreSQL (kontener bambooit_postgres — NIE publikuje portu hosta) ────────
POSTGRES_USER=bambooit
POSTGRES_PASSWORD=USTAW_SILNE_HASLO
POSTGRES_DB=bambooit_db
# DATABASE_URL składane automatycznie w docker-compose.prod.yml (host: postgres)

# ── Szyfrowanie PII (AES-256-GCM) ─────────────────────────────────────────────
# Generuj: openssl rand -hex 32
# KRYTYCZNE: utrata klucza = utrata danych zaszyfrowanych w bazie (sejf dostępów).
ENCRYPTION_KEY=

# ── JWT (access + refresh) ────────────────────────────────────────────────────
# Generuj: openssl rand -hex 32
JWT_SECRET=

# ── CORS / URL-e aplikacji ────────────────────────────────────────────────────
CORS_ORIGIN=https://bambooit.pl
APP_URL=https://bambooit.pl
PORT=4000
NODE_ENV=production

# ── E-mail (Resend — już skonfigurowany, domena bambooit.pl zweryfikowana) ─────
# utils/email.ts automatycznie wybiera Resend gdy RESEND_API_KEY jest ustawione.
RESEND_API_KEY=re_REPLACE_WITH_RESEND_KEY
RESEND_FROM_EMAIL=bambooIT <hello@bambooit.pl>
NOTIFICATIONS_TO_EMAIL=hello@bambooit.pl
# Fallback SMTP (opcjonalny — gdy nie używasz Resend):
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=bambooIT <hello@bambooit.pl>

# ── Next.js (frontend) ───────────────────────────────────────────────────────
# Browser używa same-origin /api/proxy, więc public URL = sama domena.
NEXT_PUBLIC_API_URL=https://bambooit.pl
NEXT_PUBLIC_SITE_URL=https://bambooit.pl
# Internal (kontener web → kontener backend, sieć compose):
API_URL=http://backend:4000
# SEO: blokada indeksowania przed startem. Domyślnie (brak/`false`) cała strona
# i aplikacja są noindex (robots Disallow /, X-Robots-Tag, meta robots).
# Na start produkcyjny ustaw `true` i przebuduj web.
SITE_INDEXABLE=false
# NextAuth — generuj: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=https://bambooit.pl

# ── Stripe — ODŁOŻONY (mock mode). Bez tych zmiennych płatności są wyłączone. ──
# Gdy włączasz płatności, odkomentuj i uzupełnij:
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_START=price_...
# STRIPE_PRICE_FIRMA=price_...
# STRIPE_PRICE_FIRMA_PLUS=price_...

# ── Szyfrowany backup bazy (codzienny pg_dump → GPG) ─────────────────────────
# Generuj raz, zapisz w menedżerze haseł: openssl rand -base64 32
# UTRATA TEJ FRAZY = BACKUPY NIE DO ODSZYFROWANIA.
BACKUP_PASSPHRASE=
# BACKUP_CRON_SCHEDULE=0 2 * * *
# BACKUP_RETENTION_DAYS=30
