# ─── API ───
NEXT_PUBLIC_API_URL=http://localhost:4000
# Internal API URL (server-side only — can differ from public URL in production)
API_URL=http://localhost:4000

# ─── NextAuth v5 ───
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# ─── Site URL (used for OG tags, canonical URLs, sitemap absolute URLs) ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Sentry — W6.CC.2 (error monitoring) ───
# NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development  # development | staging | production
# SENTRY_AUTH_TOKEN=                          # source maps upload at build time

# ─── Google Search Console / Analytics ───
# NEXT_PUBLIC_GSC_VERIFICATION=               # meta verification tag value
# NEXT_PUBLIC_GA_ID=                          # GA4 measurement ID, e.g. G-XXXXXXXX (Faza 5 per D-063)
