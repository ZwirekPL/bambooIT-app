                  {
                    "grams": 30,
                    "name": "Jajko kurze",
                  },
                  {
                    "grams": 7,
                    "name": "jajka, klasa a, duży, żółtko jajka",
                  },
                  {
                    "grams": 10,
                    "name": "Pecorino Romano",
                  },
