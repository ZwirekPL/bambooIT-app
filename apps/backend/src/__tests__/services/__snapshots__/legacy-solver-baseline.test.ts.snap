        "day": "Wtorek",
        "meals": [
          {
            "items": [
              {
                "carbs": 65.6,
                "fat": 16.2,
                "grams": 217,
                "ingredients": [
                  {
                    "grams": 50,
                    "name": "Mąka pszenna tortowa",
