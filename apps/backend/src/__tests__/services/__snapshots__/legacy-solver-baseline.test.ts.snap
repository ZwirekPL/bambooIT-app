                "ingredients": [
                  {
                    "grams": 130,
                    "name": "Figa świeża",
                  },
                  {
                    "grams": 9,
                    "name": "Gorgonzola Pikantna",
                  },
                  {
                    "grams": 6,
                    "name": "Orzechy Włoskie",
                  },
