                  {
                    "grams": 85,
                    "name": "Mąka pszenna tortowa",
                  },
                  {
                    "grams": 25,
                    "name": "Skrobia ziemniaczana",
                  },
                  {
                    "grams": 30,
                    "name": "Jajko kurze",
                  },
                  {
                    "grams": 1,
