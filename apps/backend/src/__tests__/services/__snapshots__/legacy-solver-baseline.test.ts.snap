                  },
                  {
                    "grams": 75,
                    "name": "Papryka czerwona",
                  },
                  {
                    "grams": 100,
                    "name": "Cukinia zielona",
                  },
                  {
                    "grams": 70,
                    "name": "Cukinia",
                  },
                  {
                    "grams": 9,
