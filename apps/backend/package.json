{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "DietetykDEV API - Express backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:scraper": "vitest run --dir scripts/scraper",
    "test:goldstandard": "cross-env RUN_GOLD_STANDARD=1 vitest run src/__tests__/services/legacy-solver-baseline.test.ts",
    "test:compose-smoke": "cross-env RUN_COMPOSE_SMOKE=1 ENABLE_3_TUPLE_COMPOSITION=true SOLVER_SEED=42 vitest run src/__tests__/smoke/compose-mode.smoke.test.ts",
    "diagnose:ingredients": "ts-node -r dotenv/config -r tsconfig-paths/register scripts/diagnose-compound-ingredients.ts",
    "diagnose:ingredients:csv": "ts-node -r dotenv/config -r tsconfig-paths/register scripts/diagnose-compound-ingredients.ts --csv",
    "suggest:ingredient-repairs": "ts-node -r dotenv/config -r tsconfig-paths/register scripts/suggest-ingredient-repairs.ts",
    "apply:ingredient-repairs": "ts-node -r dotenv/config -r tsconfig-paths/register scripts/apply-ingredient-repairs.ts",
    "analyze:shopping-efficiency": "ts-node -r dotenv/config -r tsconfig-paths/register scripts/analyze-shopping-efficiency.ts",
    "verify:bug4": "ts-node -r dotenv/config -r tsconfig-paths/register scripts/verify-bug4-end-to-end.ts"
  },
  "license": "ISC",
  "dependencies": {
    "@sentry/node": "^10.45.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.71.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "database": "file:../../packages/database",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.2",
    "openai": "^6.29.0",
    "p-queue": "^9.1.0",
    "pdfkit": "^0.17.2",
    "rate-limit-redis": "^4.3.1",
    "string-similarity": "^4.0.4",
    "stripe": "^20.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.12.7",
    "@types/nodemailer": "^7.0.11",
    "@types/pdfkit": "^0.17.5",
    "@types/string-similarity": "^4.0.2",
    "@vitest/coverage-v8": "^4.0.18",
    "cross-env": "^10.1.0",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5",
    "vitest": "^4.0.18"
  }
}
