# Database
DATABASE_URL=postgresql://bambooit:bambooit123@localhost:5433/bambooit_db?schema=public

# Encryption — generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000

# Server port (optional, defaults to 4000)
PORT=4000

# SMTP — use Mailtrap for dev: https://mailtrap.io
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DietetykAI <noreply@dietetyk.ai>"

# Frontend base URL (used in email links to password reset and email verification pages)
APP_URL=http://localhost:3000

# Redis (start with: docker-compose up -d)
REDIS_URL=redis://localhost:6380

# Paywall — set to "true" to require active order before interview/plan access (default: false)
# PAYWALL_ENABLED=false

# Stripe (optional — mock mode when absent)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe price IDs per bambooIT subscription tier (D-007 / D-018)
# STRIPE_PRICE_START=price_...      # 390 zł netto/mies (Pakiet Start, also used for TRIAL)
# STRIPE_PRICE_FIRMA=price_...      # 690 zł netto/mies (Pakiet Firma)
# STRIPE_PRICE_FIRMA_PLUS=price_... # 1190 zł netto/mies (Pakiet Firma Plus)

