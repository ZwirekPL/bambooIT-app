# Database
DATABASE_URL=postgresql://bambooit:bambooit123@localhost:5432/bambooit_db?schema=public

# Encryption — generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000

# Server port (optional, defaults to 4000)
PORT=4000

# SMTP — use Mailtrap for dev: https://mailtrap.io
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DietetykAI <noreply@dietetyk.ai>"

# Frontend base URL (used in email links to password reset and email verification pages)
APP_URL=http://localhost:3000

# Redis (start with: docker-compose up -d)
REDIS_URL=redis://localhost:6379

# Paywall — set to "true" to require active order before interview/plan access (default: false)
# PAYWALL_ENABLED=false

# Stripe (optional — mock mode when absent)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe price IDs per product type (29.2)
# STRIPE_PRICE_OPIEKA_MIESIECZNA=price_...  # 129 zł/month subscription (also used for TRIAL)
# STRIPE_PRICE_OPIEKA_ROCZNA=price_...      # 99 zł/month (1188 zł/year, -20%) subscription
# STRIPE_PRICE_PLAN_2W=price_...             # 129 zł one-time
# STRIPE_PRICE_PLAN_4W=price_...             # 199 zł one-time
# STRIPE_PRICE_CONSULTATION=price_...        # 399 zł one-time

# OpenAI — direct API integration (33.x)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL_SIMPLE=gpt-4.1           # default: gpt-4.1 (was gpt-4.1-mini before FAZA 71)
# OPENAI_MODEL_COMPLEX=gpt-4.1          # default: gpt-4.1 (was gpt-4o before FAZA 71)

# Prompt version — v2 (backup) or v3 (current: few-shot, dish templates, extended _dayCheck)
# Default: v3. V1 removed.
PROMPT_VERSION=v3

# OR-Tools solver (Python microservice, started via docker-compose)
# SOLVER_URL=http://localhost:5050   # default; override for prod (e.g. http://solver:5050 in docker network)
# SOLVER_SEED=                        # test-only: set to integer (e.g. 42) for deterministic plan generation.
                                      # NEVER set in production — would freeze plan variance across re-generations.

# Faza D: 3-tuple meal composition (LUNCH/DINNER → main + carb_side + veg_side)
# Resolution order:
#   1. ENABLE_3_TUPLE_COMPOSITION=true  → global ON (Phase 4 default-on path)
#   2. COMPOSE_MEALS_PATIENT_IDS includes patientId → per-patient opt-in
#      (Phase 2 shadow / Phase 3 beta — comma-separated cuid list)
#   3. else → OFF (legacy 1-element, gold-standard bit-equal)
# ENABLE_3_TUPLE_COMPOSITION=false
# COMPOSE_MEALS_PATIENT_IDS=cuid_patient_1,cuid_patient_2

# n8n AI workflow (optional — without these, n8n integration is disabled)
# N8N_WEBHOOK_URL — URL of n8n generate workflow (webhook path from n8n editor)
# N8N_REPAIR_WEBHOOK_URL — URL of n8n repair workflow (optional; without it, violations → MANUAL_REVIEW_REQUIRED)
# N8N_PARTIAL_REGEN_WEBHOOK_URL — URL of n8n partial regeneration workflow (optional; falls back to N8N_WEBHOOK_URL)
# N8N_API_SECRET — shared secret for authenticating n8n callbacks
# NOTE: n8n 2.10+ uses prefixed webhook URLs: /webhook/{workflowId}/webhook%2520trigger/{path}
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/{workflowId}/webhook%2520trigger/diet-plan-generate
# N8N_REPAIR_WEBHOOK_URL=http://localhost:5678/webhook/{workflowId}/webhook%2520trigger/diet-plan-validate
# N8N_PARTIAL_REGEN_WEBHOOK_URL=http://localhost:5678/webhook/{workflowId}/webhook%2520trigger/diet-plan-partial-regenerate
# N8N_API_SECRET=
