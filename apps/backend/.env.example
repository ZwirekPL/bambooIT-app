# ─── Database ───
DATABASE_URL=postgresql://bambooit:bambooit123@localhost:5433/bambooit_db?schema=public

# ─── Crypto / Auth ───
# Generate each with: openssl rand -hex 32 (min 32 chars for JWT)
ENCRYPTION_KEY=
JWT_SECRET=

# ─── CORS / Server ───
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000
# Optional, defaults to 4000
PORT=4000

# ─── Frontend base URL (used in email links — password reset, email verification) ───
APP_URL=http://localhost:3000

# ─── Redis (start with: docker-compose up -d) ───
REDIS_URL=redis://localhost:6380

# ─── Email — SMTP (Mailtrap for dev: https://mailtrap.io) ───
# NOTE: Production transactional email migrates to Resend in W5 (TODO.md §4 W5.CC.4-5).
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="bambooIT <hello@bambooit.pl>"

# ─── Resend — Faza 4 W5.CC.4 (replaces SMTP for transactional emails) ───
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=hello@bambooit.pl

# ─── Stripe (mock mode when absent; live keys swap in W6.2) ───
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_WEBHOOK_SECRET_LOCAL=whsec_...  # Stripe CLI `stripe listen` for dev (W3.1)
# Stripe price IDs per D-007 — set after creating products in Stripe Dashboard (W1.1)
# STRIPE_PRICE_START=price_...           # 390 zł netto/mies (Pakiet Start)
# STRIPE_PRICE_FIRMA=price_...           # 690 zł netto/mies (Pakiet Firma — flagship)
# STRIPE_PRICE_FIRMA_PLUS=price_...      # 1190 zł netto/mies (Pakiet Firma Plus)

# ─── Fakturownia — W5.CC.5 (Polish VAT invoicing after Stripe payment success) ───
# FAKTUROWNIA_API_TOKEN=
# FAKTUROWNIA_DOMAIN=bambooit            # https://{domain}.fakturownia.pl

# ─── Sentry — W6.CC.2 (error monitoring) ───
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_ENVIRONMENT=development         # development | staging | production

# ─── Anthropic — Faza 5 (Claude Haiku 4.5 ChatWidget) ───
# ANTHROPIC_API_KEY=sk-ant-...

# ─── Retention / scheduler (optional — defaults apply when unset) ───
# RETENTION_DELETED_USER_DAYS=90         # purge soft-deleted users after N days
# RETENTION_AUDIT_LOG_YEARS=7            # purge audit logs older than N years
# JOB_SCHEDULER_TZ=Europe/Warsaw         # cron timezone
# CLEANUP_SOFT_DELETED_CRON=0 3 * * *    # daily 03:00
# AUDIT_LOG_PURGE_CRON=0 4 1 * *         # monthly 04:00 on day 1
# BLOG_IMAGES_DIR=                       # custom upload directory for blog images
