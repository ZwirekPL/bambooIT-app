# Database
DATABASE_URL=postgresql://bambooit:bambooit123@localhost:5433/bambooit_db?schema=public

# Encryption — generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000

# Server port (optional, defaults to 4000)
PORT=4000

# SMTP — use Mailtrap for dev: https://mailtrap.io
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DietetykAI <noreply@dietetyk.ai>"

# Frontend base URL (used in email links to password reset and email verification pages)
APP_URL=http://localhost:3000

# Redis (start with: docker-compose up -d)
REDIS_URL=redis://localhost:6380

# Paywall — set to "true" to require active order before interview/plan access (default: false)
# PAYWALL_ENABLED=false

# Stripe (optional — mock mode when absent)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe price IDs per product type (29.2)
# STRIPE_PRICE_OPIEKA_MIESIECZNA=price_...  # 129 zł/month subscription (also used for TRIAL)
# STRIPE_PRICE_OPIEKA_ROCZNA=price_...      # 99 zł/month (1188 zł/year, -20%) subscription
# STRIPE_PRICE_PLAN_2W=price_...             # 129 zł one-time
# STRIPE_PRICE_PLAN_4W=price_...             # 199 zł one-time
# STRIPE_PRICE_CONSULTATION=price_...        # 399 zł one-time

