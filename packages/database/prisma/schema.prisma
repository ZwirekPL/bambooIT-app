generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  DIETITIAN
  PATIENT
}

enum ProductType {
  FREE_7
  OPIEKA_MIESIECZNA
  OPIEKA_ROCZNA
  PLAN_2W
  PLAN_4W
  CONSULTATION
  // Legacy values (kept for backward compatibility with existing orders)
  PREMIUM
  CONSULTATION_1W
  AI_2W
  AI_4W
  SUBSCRIPTION_1M
  CONSULTATION_2W
  CONSULTATION_4W
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  ACTIVE
  COMPLETED
  CANCELLED
}

// AddonType enum removed in 29.1.1 — no longer used

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum SubscriptionPlan {
  FREE
  PRO_MONTHLY
  PRO_YEARLY
}

// ─── Food Database Enums ──────────────────────────────────────────────────────

// ─── Nutrition Protocols (28.1) ───────────────────────────────────────────────

model DietitianProfile {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  code                    String   @unique
  firstName               String?
  lastName                String?
  scoringWeightsOverride  Json?    /// Per-dietitian scoring weight overrides (partial ScoringWeights JSON)
  greyListWindow          Int      @default(1) /// How many previous plans contribute recipe IDs to the regeneration grey list (1-4). 0 disables grey list.
  createdAt               DateTime @default(now())
  updatedAt               DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  role          UserRole  @default(PATIENT)
  emailVerified       DateTime?
  lastLoginAt         DateTime?
  grantedAccessUntil  DateTime?
  deletedAt           DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  patient                 Patient?                 @relation("PatientUser")
  patientsAsDietitian     Patient[]                @relation("PatientDietitian")
  dietitianProfile        DietitianProfile?
  subscription            Subscription?
  auditLogs               AuditLog[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  testimonial             Testimonial?
  notificationPreferences NotificationPreferences?
  referralCode            ReferralCode?
  referralUsagesAsReferred ReferralUsage[]         @relation("ReferredUser")
  consents                UserConsent[]
  // Protocol relations (28.1)
  trialFingerprints       TrialFingerprint[]
  deviceFingerprints      DeviceFingerprint[]
  // Chat (79.1)
  // Supplements (79.6)
}

model Patient {
  id          String   @id @default(cuid())
  userId      String   @unique
  dietitianId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  firstName String?
  lastName  String?
  sex       String?
  birthYear Int?
  birthDate DateTime?
  heightCm  Int?
  weightKg      Decimal?  @db.Decimal(6, 2)

  user             User              @relation("PatientUser", fields: [userId], references: [id], onDelete: Cascade)
  dietitian        User?             @relation("PatientDietitian", fields: [dietitianId], references: [id])
  orders           Order[]

  @@index([dietitianId])
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  action       String
  resourceType String?
  resourceId   String?
  ip           String?
  metadata     Json?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

/// Audit trail for BUG-3 ingredient cleanup — every displayName change is logged here
/// so the operation is reversible per-batch. One row = one mutation (update/split/delete/insert).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Order {
  id                String      @id @default(cuid())
  patientId         String
  productType       ProductType
  status            OrderStatus @default(PENDING_PAYMENT)
  consultationPhone  String?     @db.VarChar(20)
  stripeInvoiceId    String?
  createdAt          DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

// @deprecated — artifact, scheduled for removal in a future migration (31.7)
model Post {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  titleEn     String?
  excerpt     String
  excerptEn   String?
  content     String // Markdown, always in Polish
  contentEn   String? // Markdown, English translation
  category    String
  author      String
  imageSrc    String?
  imageAlt    String?
  imageAltEn  String?
  readTime    Int
  publishedAt  DateTime
  published    Boolean   @default(false)
  scheduledAt  DateTime? // If set and > now(), post is hidden from public API
  faq          Json? // Array of { question: string; answer: string }
  viewCount    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([slug])
  @@index([category])
  @@index([published])
  @@index([scheduledAt])
}

model BlogCategoryConfig {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

