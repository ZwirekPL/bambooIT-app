// RECIPES
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Recipe Ingredients ──────────────────────────────────────────────────────

// ─── Recipe Instruction Steps ────────────────────────────────────────────────

// ─── Recipe Nutrition Snapshot ───────────────────────────────────────────────

// ─── Recipe Allergens (computed from ingredients) ────────────────────────────

// ─── Recipe Diet Flags (computed from ingredients) ───────────────────────────

// ─── Recipe Ratings (37.5) ──────────────────────────────────────────────────

// ─── Shopping List Checks (63.3) ────────────────────────────────────────────

// ─── Favorite Meals (64.2) ──────────────────────────────────────────────────

// ─── Ingredient Substitution Rules ───────────────────────────────────────────

// ═══════════════════════════════════════════════════════════════════════════════
// DATA QUALITY & IMPORT INFRASTRUCTURE
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Nutrition targets ────────────────────────────────────────────────────────

// ─── Meal Library ─────────────────────────────────────────────────────────────

// ─── Template Plans (7.10.2) ──────────────────────────────────────────────────

// ─── Diet plan versioning (7.11) ─────────────────────────────────────────────

// ─── Weekly Check-ins (7.13) ─────────────────────────────────────────────────

// ─── Supplement Prescriptions (79.6) ─────────────────────────────────────────

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(TRIALING)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Diet Template Cache (17.2) ─────────────────────────────────────────────

// ─── AI Usage Telemetry (7.14.1) ────────────────────────────────────────────

// ─── Feature Flags (7.14.2) ─────────────────────────────────────────────────

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "n8n_generation", "stripe_payments", "checkin_adjustments"
  name        String // human-readable name
  description String?  @db.Text
  enabled     Boolean  @default(false) // global on/off
  /// JSON conditions: { roles?: string[], userIds?: string[], percentage?: number }
  conditions  Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@index([enabled])
}

enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
}

model Testimonial {
  id           String            @id @default(cuid())
  userId       String            @unique
  user         User              @relation(fields: [userId], references: [id])
  content      String            @db.Text
  rating       Int // 1-5
  status       TestimonialStatus @default(PENDING)
  adminReply   String?           @db.Text
  adminReplyAt DateTime?
  isPinned     Boolean           @default(false)
  pinnedOrder  Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  reviewedAt   DateTime?
  reviewedBy   String?

  @@index([status])
  @@index([isPinned])
}

// ─── Notification Preferences (19.2) ──────────────────────────────────────────

model NotificationPreferences {
  id     String @id @default(cuid())
  userId String @unique

  // Email reminders toggle
  emailReminders Boolean @default(false)

  // Meal times (HH:MM format, e.g. "08:00")
  breakfastTime String? // default null = no reminder
  lunchTime     String? // default null = no reminder
  dinnerTime    String? // default null = no reminder
  snackTime     String? // default null = no reminder

  // Reminder lead time in minutes (how long before meal to send reminder)
  reminderLeadMinutes Int @default(30)

  // Weekly summary email
  weeklySummary Boolean @default(true)

  // Timezone (IANA, e.g. "Europe/Warsaw")
  timezone String @default("Europe/Warsaw")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ReferralCode {
  id              String   @id @default(cuid())
  userId          String   @unique
  code            String   @unique @db.VarChar(20)
  discountPercent Int      @default(20)
  createdAt       DateTime @default(now())

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  usages ReferralUsage[]
}

model ReferralUsage {
  id             String   @id @default(cuid())
  referralCodeId String
  referredUserId String
  orderId        String?
  createdAt      DateTime @default(now())

  referralCode ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)
  referredUser User         @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@unique([referralCodeId, referredUserId])
  @@index([referralCodeId])
  @@index([referredUserId])
}


enum ConsentType {
  HEALTH_DATA_PROCESSING
  AI_DISCLAIMER
  EMAIL_NOTIFICATIONS
  TERMS_ACCEPTANCE
  PRIVACY_POLICY
  COOKIE_FUNCTIONAL
  COOKIE_ANALYTICS
  COOKIE_MARKETING
}

model UserConsent {
  id              String      @id @default(cuid())
  userId          String
  consentType     ConsentType
  granted         Boolean     @default(true)
  documentVersion String      @default("1.0") @db.VarChar(20)
  acceptedAt      DateTime    @default(now())
  revokedAt       DateTime?
  ipAddress       String?     @db.VarChar(45)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, consentType])
}

